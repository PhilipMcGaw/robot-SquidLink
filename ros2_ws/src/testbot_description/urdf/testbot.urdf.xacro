<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="testbot">

  <!-- Provisional values. Replace these with measured Testbot values. -->
  <xacro:property name="body_length" value="0.40"/>
  <xacro:property name="body_width" value="0.30"/>
  <xacro:property name="body_height" value="0.12"/>
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_separation" value="0.34"/>
  <xacro:property name="camera_mount_height" value="0.20"/>

  <material name="testbot_blue"><color rgba="0.10 0.30 0.80 1.0"/></material>
  <material name="rubber"><color rgba="0.04 0.04 0.04 1.0"/></material>
  <material name="camera_black"><color rgba="0.02 0.02 0.02 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${wheel_radius}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="testbot_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${wheel_radius}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${wheel_radius}"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.10"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name y_position">
    <link name="${name}">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.002"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="0 ${y_position} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left_wheel" y_position="${wheel_separation / 2}"/>
  <xacro:wheel name="right_wheel" y_position="${-wheel_separation / 2}"/>

  <link name="camera_mount_link">
    <visual>
      <origin xyz="0 0 ${camera_mount_height / 2}"/>
      <geometry><box size="0.06 0.06 ${camera_mount_height}"/></geometry>
      <material name="testbot_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${camera_mount_height / 2}"/>
      <geometry><box size="0.06 0.06 ${camera_mount_height}"/></geometry>
    </collision>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="${body_length / 2 - 0.05} 0 ${wheel_radius + body_height / 2}"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.05 0.03 0.03"/></geometry>
      <material name="camera_black"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.03 0.03"/></geometry>
    </collision>
  </link>

  <joint name="camera_tilt_joint" type="revolute">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 ${camera_mount_height}"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785" upper="0.785" effort="0.2" velocity="1.0"/>
  </joint>

</robot>