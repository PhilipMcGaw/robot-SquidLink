{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			"**/__pycache__": true,
			"**/*.pyc": true,
			"**/node_modules": true,
			"**/.pytest_cache": true,
			"**/.venv": true,
			"**/build": true,
			"**/install": true,
			"**/log": true
		},
		"files.watcherExclude": {
			"**/__pycache__": true,
			"**/node_modules": true,
			"**/venv": true,
			"**/.venv": true,
			".git": true,
			"**/build": true,
			"**/install": true,
			"**/log": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/__pycache__": true,
			".git": true,
			"venv": true,
			".venv": true,
			"**/build": true,
			"**/install": true,
			"**/log": true
		},
		"editor.rulers": [88, 120],
		"editor.trimAutoWhitespace": true,
		"files.trimTrailingWhitespace": true,
		"editor.wordWrap": "on",
		"chat.tools.terminal.autoApprove": {
			"mkdir": true,
			"cp": true,
			"true": true
		},
		"better-todo-tree.tree.hideCompletedItems": false,
		"better-todo-tree.tree.defaultExpandedFolders": ["/"],
		"better-todo-tree.highlights.highlightDelay": 500,
		"better-todo-tree.regex": {
			"default": "([^\\w\\s]|^)\\s*(TODO|FIXME|NOTE|HACK|BUG|XXX|ROADMAP)\\s*:?\\s*(.*)$"
		},
		"better-todo-tree.highlights": {
			"TODO": {
				"foreground": "#A6E3A1",
				"type": "text"
			},
			"FIXME": {
				"foreground": "#F38BA8",
				"type": "text"
			},
			"BUG": {
				"foreground": "#EBA0AC",
				"type": "text"
			},
			"HACK": {
				"foreground": "#F9E2AF",
				"type": "text"
			},
			"NOTE": {
				"foreground": "#89B4FA",
				"type": "text"
			},
			"XXX": {
				"foreground": "#EBA0AC",
				"fontStyle": "bold",
				"type": "text"
			},
			"ROADMAP": {
				"foreground": "#CBA6F7",
				"type": "text"
			}
		},
		"better-todo-tree.tree.excludeFolders": [
			"node_modules",
			".git",
			"venv",
			".venv",
			"__pycache__",
			"*.egg-info",
			".pytest_cache",
			"build",
			"install",
			"log",
			"dist",
			".ruff_cache"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": []
	},
	"extensions": {
		"recommendations": [
			"ms-iot.vscode-ros"
		]
	}
}